{
  "name": "routini-monorepo",
  "version": "1.0.0",
  "description": "A minimal router for React with lazy, code-split routes, View Transitions, and error recovery built in.",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build -w packages/routini",
    "dev:package": "npm run dev -w packages/routini",
    "dev:website": "npm run dev -w examples/website",
    "test": "npm run test --workspaces --if-present"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kebinbin/routini.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kebinbin/routini/issues"
  },
  "homepage": "https://github.com/kebinbin/routini#readme",
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0"
  }
}
